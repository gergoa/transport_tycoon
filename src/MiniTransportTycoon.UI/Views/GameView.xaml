<UserControl x:Class="MiniTransportTycoon.UI.Views.GameView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:local="clr-namespace:MiniTransportTycoon.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="750"
             Background="#0F1E1E">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>


        <glWpfControl:GLWpfControl x:Name="MapRenderControl" 
                               Render="MapRenderControl_OnRender" 
                               Ready="MapRenderControl_OnReady"
                               Focusable="True"
                               MouseDown="MapRenderControl_MouseDown" 
                               MouseWheel="MapRenderControl_MouseWheel"
                               SizeChanged="MapRenderControl_SizeChanged"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
            Background="#0F1E1E"
            Padding="8">

                <Border.Resources>
                    <Style x:Key="ToolbarButton" TargetType="Control">
                        <Setter Property="Foreground" Value="#2ECC71"/>
                        <Setter Property="Background" Value="#0F1E1E"/>
                        <Setter Property="BorderBrush" Value="#2ECC71"/>
                        <Setter Property="FontFamily" Value="Verdana"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="15" />
                    </Style>
                </Border.Resources>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">

                        <Button Content="New Game"
                        Command="{Binding NewGameCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Margin="6"
                        BorderBrush="#1FA2FF"
                        Foreground="#1FA2FF"/>

                        <Grid>
                            <ToggleButton x:Name="BuildBtn"
                                  Content="Build"
                                  Style="{StaticResource ToolbarButton}"
                                  Margin="6"/>

                            <Popup IsOpen="{Binding IsChecked, ElementName=BuildBtn}"
                           PlacementTarget="{Binding ElementName=BuildBtn}"
                           Placement="Bottom"
                           StaysOpen="False">

                                <StackPanel Background="#0F1E1E">
                                    <Button Content="Road" Command="{Binding SelectRoadModeCommand}" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="Bridge" Command="{Binding SelectBridgeModeCommand}" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="Stop" Command="{Binding SelectStopModeCommand}" Style="{StaticResource ToolbarButton}"/>
                                </StackPanel>
                            </Popup>
                        </Grid>

                        <Grid>
                            <ToggleButton x:Name="BuyBtn"
                                  Content="Vehicle"
                                  Style="{StaticResource ToolbarButton}"
                                  IsChecked="{Binding IsVehicleMenuOpen}"
                                  Margin="6"/>

                            <Popup IsOpen="{Binding IsVehicleMenuOpen}"
                           PlacementTarget="{Binding ElementName=BuyBtn}"
                           Placement="Bottom"
                           StaysOpen="True"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                                <StackPanel Background="#0F1E1E">

                                    <!-- OWNED VEHICLES -->
                                    <ItemsControl ItemsSource="{Binding Vehicles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ToolbarButton}">
                                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     Foreground="White"
                                                     BorderThickness="0"
                                                     FontWeight="Bold"
                                                     KeyDown="VehicleNameTextBox_KeyDown"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- BUY SUBMENU -->
                                    <Grid>
                                        <ToggleButton x:Name="BuyVehicleBtn"
                                              Content="Buy..."
                                              Style="{StaticResource ToolbarButton}"/>

                                        <Popup IsOpen="{Binding IsChecked, ElementName=BuyVehicleBtn}"
                                       PlacementTarget="{Binding ElementName=BuyVehicleBtn}"
                                       Placement="Right"
                                       StaysOpen="True"
                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                                            <Grid Background="#0F1E1E">

                                                <!-- VEHICLE TYPE LIST -->
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectingVehicleRoute}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <Button Command="{Binding BuySmallBusCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Small Bus" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Passengers" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyLargeBusCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Large Bus" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Passengers" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyLightTier0TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Small Raw Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Wood, Ore, Coal, Oil, Grain" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyHeavyTier0TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Large Raw Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Wood, Ore, Coal, Oil, Grain" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyLightTier1TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Small Tier 1 Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Lumber, Wire, Plastic, Steel" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyHeavyTier1TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Large Tier 1 Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Lumber, Wire, Plastic, Steel" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyLightTier2TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Small Tier 2 Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Food, Microchips, Tools, Furniture" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyHeavyTier2TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Large Tier 2 Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Food, Microchips, Tools, Furniture" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyLightTier3TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Small Tier 3 Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Automobiles, Electronics" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding BuyHeavyTier3TruckCommand}" Style="{StaticResource ToolbarButton}">
                                                        <StackPanel>
                                                            <TextBlock Text="Large Tier 3 Truck" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Automobiles, Electronics" FontSize="10" Foreground="#B8FFF2" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- ROUTE SELECTION -->
                                                <StackPanel Visibility="{Binding IsSelectingVehicleRoute,
                                                    Converter={StaticResource BoolToVis}}">

                                                    <TextBlock Text="Select route stops"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       Margin="8"/>

                                                    <TextBlock Text="{Binding PendingRouteText}"
                                                       Foreground="#B8FFF2"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Width="220"
                                                       Margin="8,0,8,8"/>

                                                    <Button Content="Cancel"
                                                    Command="{Binding CancelVehiclePurchaseCommand}"
                                                    Style="{StaticResource ToolbarButton}"
                                                    Margin="8,0,8,8"/>
                                                </StackPanel>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </Popup>
                        </Grid>

                        <Grid>
                            <ToggleButton x:Name="TimeBtn"
                                  Content="Speed"
                                  Style="{StaticResource ToolbarButton}"
                                  Margin="6"/>

                            <Popup IsOpen="{Binding IsChecked, ElementName=TimeBtn}"
                           PlacementTarget="{Binding ElementName=TimeBtn}"
                           Placement="Bottom"
                           StaysOpen="False">

                                <StackPanel Background="#0F1E1E">
                                    <Button Content="Normal" Command="{Binding NormalSpeedCommand}" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="Pause" Command="{Binding PauseCommand}" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="2x" Command="{Binding FastSpeedCommand}" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="4x" Command="{Binding VeryFastSpeedCommand}" Style="{StaticResource ToolbarButton}"/>
                                </StackPanel>
                            </Popup>
                        </Grid>

                        <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ClearBuildModeCommand}"
                        Margin="6"
                        BorderBrush="#1FA2FF"
                        Foreground="#1FA2FF">
                            <TextBlock>
                        <Run Text="Active:"/>
                        <Run Text="{Binding CurrentBuildMode}"/>
                            </TextBlock>
                        </Button>

                    </StackPanel>

                    <!--StatusBar helyett-->
                    <StackPanel Orientation="Horizontal"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                        <TextBlock Text="Time:"
                           Foreground="White"
                           Margin="6,0"
                           FontFamily="Verdana"
                           FontWeight="Bold"
                           FontSize="15"/>
                        <TextBlock Text="{Binding Time}"
                           Foreground="#1FA2FF"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="6,0"/>

                        <TextBlock Text="Money:"
                           Foreground="White"
                           Margin="12,0,0,0"
                           FontFamily="Verdana"
                           FontWeight="Bold"
                           FontSize="15"/>
                        <TextBlock Text="{Binding Money}"
                           Foreground="#2ECC71"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="6,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Viewbox Grid.Row="1" Stretch="Uniform">
                <Grid Width="500" Height="500">


                <Border Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="20" Width="150" Height="150"
                BorderBrush="White" BorderThickness="2" Background="#CC000000" CornerRadius="5" ClipToBounds="True">

                    <Viewbox Stretch="Fill">
                        <Grid Width="500" Height="500">
                            
                            <glWpfControl:GLWpfControl x:Name="MiniMapRenderControl" 
                                                       Render="MiniMapRenderControl_OnRender"/>
                           

                            <!--
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Width}" Rows="{Binding Height}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Control.Padding" Value="0"/>
                                        <Setter Property="Control.Margin" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle>
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="LightGreen"/>
