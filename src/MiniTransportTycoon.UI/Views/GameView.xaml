<UserControl x:Class="MiniTransportTycoon.UI.Views.GameView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MiniTransportTycoon.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="750">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="Új játék" Command="{Binding NewGameCommand}"/>
            <MenuItem Header="Tick" Command="{Binding TickCommand}"/>
        </Menu>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Width}" Rows="{Binding Height}" Height="700" Width="700"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="Control.Padding" Value="0"/>
                    <Setter Property="Control.Margin" Value="0"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button BorderThickness="0.5" Focusable="False"
                            Command="{Binding DataContext.FieldClickCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="EMPTY">
                                        <Setter Property="Background" Value="LightGreen"/>
                                        <Setter Property="BorderBrush" Value="DarkGray"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="FOREST">
                                        <Setter Property="Background" Value="Green"/>
                                        <Setter Property="BorderBrush" Value="LightGray"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="WATER">
                                        <Setter Property="Background" Value="Blue"/>
                                        <Setter Property="BorderBrush" Value="LightGray"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="ROAD">
                                        <Setter Property="Background" Value="#464646"/>
                                        <Setter Property="BorderBrush" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="BRIDGE">
                                        <Setter Property="Background" Value="OrangeRed"/>
                                        <Setter Property="BorderBrush" Value="DarkGray"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="INDUSTRY">
                                        <Setter Property="Background" Value="Orange"/>
                                        <Setter Property="BorderBrush" Value="LightGray"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="CITY">
                                        <Setter Property="Background" Value="DarkViolet"/>
                                        <Setter Property="BorderBrush" Value="LightGray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="Time: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Time}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="Money: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Money}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding DebugText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
