<UserControl x:Class="MiniTransportTycoon.UI.Views.GameView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:local="clr-namespace:MiniTransportTycoon.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Background="#0F1E1E">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolbarButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#2ECC71"/>
            <Setter Property="Background" Value="#CC0F1E1E"/>
            <Setter Property="BorderBrush" Value="#2ECC71"/>
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <glWpfControl:GLWpfControl x:Name="MapRenderControl" 
                                   Render="MapRenderControl_OnRender" 
                                   Ready="MapRenderControl_OnReady"
                                   Focusable="True"
                                   MouseDown="MapRenderControl_MouseDown" 
                                   MouseWheel="MapRenderControl_MouseWheel"
                                   SizeChanged="MapRenderControl_SizeChanged"/>

        <Border VerticalAlignment="Top" 
                Background="#D90F1E1E" 
                Padding="10" 
                BorderBrush="#2ECC71" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="New Game"
                            Command="{Binding NewGameCommand}"
                            Style="{StaticResource ToolbarButton}"
                            BorderBrush="#1FA2FF"
                            Foreground="#1FA2FF"/>

                    <Grid>
                        <ToggleButton x:Name="BuildBtn" Content="Build" Style="{StaticResource ToolbarButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=BuildBtn}"
                               PlacementTarget="{Binding ElementName=BuildBtn}"
                               Placement="Bottom" StaysOpen="False">
                            <StackPanel Background="#0F1E1E">
                                <Button Content="Road" Command="{Binding SelectRoadModeCommand}" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="Bridge" Command="{Binding SelectBridgeModeCommand}" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="Stop" Command="{Binding SelectStopModeCommand}" Style="{StaticResource ToolbarButton}"/>
                            </StackPanel>
                        </Popup>
                    </Grid>

                    <Grid>
                        <ToggleButton x:Name="BuyBtn"
                                      Content="Vehicle"
                                      Style="{StaticResource ToolbarButton}"
                                      IsChecked="{Binding IsVehicleMenuOpen}"
                                      Margin="6"/>

                        <Popup IsOpen="{Binding IsVehicleMenuOpen}"
                               PlacementTarget="{Binding ElementName=BuyBtn}"
                               Placement="Bottom"
                               StaysOpen="True"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                            <StackPanel Background="#0F1E1E">

                                <!-- OWNED VEHICLES -->
                                <ItemsControl ItemsSource="{Binding Vehicles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToolbarButton}">
                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent"
                                                         Foreground="White"
                                                         BorderThickness="0"
                                                         FontWeight="Bold"
                                                         KeyDown="VehicleNameTextBox_KeyDown"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- BUY SUBMENU -->
                                <Grid>
                                    <ToggleButton x:Name="BuyVehicleBtn"
                                                  Content="Buy..."
                                                  Style="{StaticResource ToolbarButton}"/>

                                    <Popup IsOpen="{Binding IsChecked, ElementName=BuyVehicleBtn}"
                                           PlacementTarget="{Binding ElementName=BuyVehicleBtn}"
                                           Placement="Right"
                                           StaysOpen="True"
                                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                                        <Grid Background="#0F1E1E">

                                            <!-- VEHICLE TYPE LIST -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectingVehicleRoute}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Button Content="Small Bus" Command="{Binding BuySmallBusCommand}" Style="{StaticResource ToolbarButton}"/>
                                                <Button Content="Large Bus" Command="{Binding BuyLargeBusCommand}" Style="{StaticResource ToolbarButton}"/>

                                                <Button Content="Small Raw Material Truck" Command="{Binding BuyLightTier0TruckCommand}" Style="{StaticResource ToolbarButton}"/>
                                                <Button Content="Large Raw Material Truck" Command="{Binding BuyHeavyTier0TruckCommand}" Style="{StaticResource ToolbarButton}"/>

                                                <Button Content="Small Processing Truck" Command="{Binding BuyLightTier1TruckCommand}" Style="{StaticResource ToolbarButton}"/>
                                                <Button Content="Large Processing Truck" Command="{Binding BuyHeavyTier1TruckCommand}" Style="{StaticResource ToolbarButton}"/>

                                                <Button Content="Small Industrial Truck" Command="{Binding BuyLightTier2TruckCommand}" Style="{StaticResource ToolbarButton}"/>
                                                <Button Content="Large Industrial Truck" Command="{Binding BuyHeavyTier2TruckCommand}" Style="{StaticResource ToolbarButton}"/>

                                                <Button Content="Small High-Tech Truck" Command="{Binding BuyLightTier3TruckCommand}" Style="{StaticResource ToolbarButton}"/>
                                                <Button Content="Large High-Tech Truck" Command="{Binding BuyHeavyTier3TruckCommand}" Style="{StaticResource ToolbarButton}"/>
                                            </StackPanel>

                                            <!-- ROUTE SELECTION -->
                                            <StackPanel Visibility="{Binding IsSelectingVehicleRoute,
                                                        Converter={StaticResource BoolToVis}}">

                                                <TextBlock Text="Select route stops"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           Margin="8"/>

                                                <TextBlock Text="{Binding PendingRouteText}"
                                                           Foreground="#B8FFF2"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           Width="220"
                                                           Margin="8,0,8,8"/>

                                                <Button Content="Cancel"
                                                        Command="{Binding CancelVehiclePurchaseCommand}"
                                                        Style="{StaticResource ToolbarButton}"
                                                        Margin="8,0,8,8"/>
                                            </StackPanel>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Popup>
                    </Grid>

                    <Grid>
                        <ToggleButton x:Name="TimeBtn" Content="Speed" Style="{StaticResource ToolbarButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=TimeBtn}"
                               PlacementTarget="{Binding ElementName=TimeBtn}"
                               Placement="Bottom" StaysOpen="False">
                            <StackPanel Background="#0F1E1E">
                                <Button Content="Normal" Command="{Binding NormalSpeedCommand}" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="Pause" Command="{Binding PauseCommand}" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="2x" Command="{Binding FastSpeedCommand}" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="4x" Command="{Binding VeryFastSpeedCommand}" Style="{StaticResource ToolbarButton}"/>
                            </StackPanel>
                        </Popup>
                    </Grid>

                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ClearBuildModeCommand}"
                            Margin="6"
                            BorderBrush="#1FA2FF"
                            Foreground="#1FA2FF">
                        <TextBlock>
                            <Run Text="Active:"/>
                            <Run Text="{Binding CurrentBuildMode}"/>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Time:" Foreground="White" Margin="10,0,5,0" FontFamily="Verdana" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Time}" Foreground="#1FA2FF" FontWeight="Bold" Margin="0,0,15,0"/>

                    <TextBlock Text="Money:" Foreground="White" Margin="10,0,5,0" FontFamily="Verdana" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Money}" Foreground="#2ECC71" FontWeight="Bold"/>

                    <TextBlock Text="Money:"
                               Foreground="White"
                               Margin="12,0,0,0"
                               FontFamily="Verdana"
                               FontWeight="Bold"
                               FontSize="15"/>
                    <TextBlock Text="{Binding Money}"
                               Foreground="#2ECC71"
                               FontWeight="Bold"
                               FontSize="15"
                               Margin="6,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="#E6000000" CornerRadius="10" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVis}}">

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding OverlayTitle}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Production / Passenger:" Foreground="LightGray" FontWeight="Bold" Margin="0,0,0,5" FontSize="11"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="Rate" Foreground="White" HorizontalAlignment="Left" FontSize="12"/>
                        <TextBlock Text="{Binding FacilityRateText}" Foreground="#2ECC71" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Requires / Accepts:" Foreground="LightGray" FontWeight="Bold" Margin="0,0,0,5" FontSize="11"/>
                    <ItemsControl ItemsSource="{Binding InventoryInList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Text="{Binding Cargo}" Foreground="White" HorizontalAlignment="Left" FontSize="12"/>
                                    <TextBlock Text="{Binding Amount}" Foreground="#1FA2FF" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="Produces / Holding:" Foreground="LightGray" FontWeight="Bold" Margin="0,0,0,5" FontSize="11"/>
                    <ItemsControl ItemsSource="{Binding InventoryOutList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Text="{Binding Cargo}" Foreground="White" HorizontalAlignment="Left" FontSize="12"/>
                                    <TextBlock Text="{Binding Amount}" Foreground="Yellow" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Grid.Row="4" Content="Close" Command="{Binding CloseOverlayCommand}" Padding="5" Margin="0,10,0,0" Background="#444" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="4" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGameOver}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid IsHitTestVisible="False" Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVis}}">
                <Border Background="#CC000000">
                    <TextBlock Text="GAME OVER" FontSize="72" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>