                                                        <DataTrigger Binding="{Binding Type}" Value="WATER">
                                                            <Setter Property="Fill" Value="Blue"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="ROAD">
                                                            <Setter Property="Fill" Value="#464646"/>
                                                        </DataTrigger>

                                                    <DataTrigger Binding="{Binding BridgeType}" Value="Wooden">
                                                        <Setter Property="Fill" Value="White"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding BridgeType}" Value="Steel">
                                                        <Setter Property="Fill" Value="Yellow"/>
