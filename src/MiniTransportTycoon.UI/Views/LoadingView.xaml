<UserControl x:Class="MiniTransportTycoon.UI.Views.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">

    <Grid>

        <Grid>
            <Rectangle Fill="#0F1E1E"/>

            <Ellipse Width="600" Height="600"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-150,-150,0,0"
                     Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1FA2FF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="700" Height="700"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-200,-200"
                     Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2ECC71" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="500" Height="500"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Opacity="0.4">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00C9A7" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Loading Game..."
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="#1FA2FF"
                       FontFamily="Verdana"
                       Margin="20"
                       HorizontalAlignment="Center"/>

            
        </StackPanel>

    </Grid>
</UserControl>